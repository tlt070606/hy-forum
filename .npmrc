# ============================================================================
# 为什么需要这个文件（不是可选优化，是本机必需）
# ----------------------------------------------------------------------------
# 本机的 npm 全局缓存目录是 C:\Users\<user>\AppData\Local\npm-cache，
# 但 agent 的文件沙箱只允许写工作区目录 D:\demo\Hy论坛_uni-app 之下，
# 于是 `npm install` 会在写缓存时报：EPERM: operation not permitted, open
#   'C:\Users\...\AppData\Local\npm-cache\_cacache\tmp\***'
# 该报错看起来像"盘满/杀毒软件锁文件/权限不足"，实际根因是**沙箱写权范围**。
# 把缓存重定向到工作区内即可，不改任何全局配置，不污染其他项目。
# ============================================================================

cache=.npm-cache

# 国内镜像：本机 npm 全局 registry 已是 npmmirror，这里显式固化，
# 保证换机器/换 shell 后行为一致（不依赖用户级配置）。
registry=https://registry.npmmirror.com

# @dcloudio 的 alpha/快照版本较多，避免 npm 因 peer 冲突直接失败
# （uni-app 的 peer 声明常年滞后于它自己实际依赖的 Vue 小版本）
legacy-peer-deps=true
