{
  "name": "hy-forum-web",
  "version": "0.1.0",
  "private": true,
  "description": "Hy论坛 唯一前端（uni-app）：一套代码编译 H5 网站 / 安卓 App / 微信小程序（仅练习）",
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:app": "uni -p app",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:app": "uni build -p app",
    "type-check": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "gen:api": "openapi-typescript src/api/generated/openapi.snapshot.json -o src/api/generated/schema.d.ts",
    "check:contract": "node scripts/check-contract.mjs",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-plus": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "pinia": "^2.3.1",
    "vue": "^3.4.21",
    "wot-design-uni": "^1.14.0"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-automator": "3.0.0-5020420260813003",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@vue/runtime-core": "^3.4.21",
    "@vue/tsconfig": "^0.5.1",
    "openapi-typescript": "^7.13.0",
    "rollup": "4.14.3",
    "sass": "^1.77.0",
    "typescript": "^5.6.0",
    "vite": "5.2.8",
    "vue-tsc": "^2.1.0"
  }
}
