rs/{id}/follows":{"get":{"tags":["关注"],"summary":"某用户关注的人","description":"按关注时间倒序分页","operationId":"listFollowing","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":1}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":20}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponsePageResultFollowUserVO"}}}}}}},"/api/users/{id}/fans":{"get":{"tags":["关注"],"summary":"某用户的粉丝","description":"按关注时间倒序分页","operationId":"listFans","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":1}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":20}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponsePageResultFollowUserVO"}}}}}}},"/api/users/{id}/comments":{"get":{"tags":["用户主页"],"summary":"某用户的评论","description":"只返回正常状态的评论，带 postTitle；时间倒序分页","operationId":"listComments","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":1}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":20}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponsePageResultUserCommentVO"}}}}}}},"/api/user/me":{"get":{"tags":["用户"],"summary":"当前登录用户信息","description":"需要登录；用户 id 取自登录态，不接受前端传参","operationId":"me","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseUserVO"}}}}}}},"/api/user/collections":{"get":{"tags":["用户